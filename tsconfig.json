{
    "include": ["./src"],
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "useUnknownInCatchVariables": false,
        "target": "ES2022",
        "strict": true,
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": false,
        "declaration": true,
        "sourceMap": true,
        "inlineSources": true,
        "outDir": "build",
        "rootDir": "src",
        "sourceRoot": "src",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "lib": ["es2018", "DOM"],
        "jsx": "react",
        "types": ["@iobroker/types"]
    }
}
