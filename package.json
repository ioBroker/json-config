{
    "name": "@iobroker/json-config",
    "description": "This package contains the ioBroker JSON config UI components",
    "version": "9.0.8",
    "author": {
        "name": "bluefox",
        "email": "dogafox@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ioBroker/json-config.git"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/json-config/issues"
    },
    "license": "MIT",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "scripts": {
        "build": "tsc && tsc-alias && node after_build",
        "clean": "rimraf build",
        "prepublishOnly": "npm run build",
        "build:ts": "tsc -p tsconfig.json",
        "lint": "eslint -c eslint.config.mjs",
        "test": "npm run test:integration",
        "test:integration": "npm run test:tsc && node test/testSchema.js",
        "test:tsc": "tsc -p test/tsconfig.build.json",
        "release": "release-script --noPush --yes --lf",
        "release-patch": "release-script patch --yes --lf",
        "release-minor": "release-script minor --yes --lf",
        "release-major": "release-script major --yes --lf",
        "update-packages": "npx -y npm-check-updates --upgrade"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@iobroker/gui-components": "^10.0.6",
        "@module-federation/runtime": "^2.8.0",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "@mui/x-date-pickers": "^9.10.1",
        "crypto-js": "^4.2.0",
        "json5": "^2.2.3",
        "react": "^19.2.8",
        "react-ace": "^14.0.1",
        "react-dom": "^19.2.8",
        "react-dropzone": "^19.1.1",
        "react-qr-code": "^2.2.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-license": "^5.2.0",
        "@iobroker/build-tools": "^3.0.1",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/types": "^7.2.2",
        "@types/crypto-js": "^4.2.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^19.2.3",
        "ajv": "^8.20.0",
        "date-fns": "^4.4.0",
        "react-color": "^2.19.3",
        "tsc-alias": "^1.9.1",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3"
    },
    "files": [
        "build/",
        "LICENSE"
    ]
}
