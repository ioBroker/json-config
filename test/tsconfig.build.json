{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": false,
        "declaration": false,
        "skipLibCheck": true,
        "module": "nodenext",
        "moduleResolution": "nodenext"
    },
    "include": ["./**/*.ts"],
    // the unit tests reach into ../src and are built by tsconfig.unit.json instead
    "exclude": ["./testEncryptedNative.ts", "./build-test/**"]
}
